{
  "name": "linux-computer-use",
  "version": "0.1.0",
  "description": "Unified Linux desktop control layer for AI agents",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "tsc",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "linux",
    "desktop",
    "automation",
    "mcp",
    "accessibility",
    "agent"
  ],
  "author": "Dream Pixels Forge",
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "chalk": "^5.0.0"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.0.0"
  }
}
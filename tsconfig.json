{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "rootDir": "./src/types",
    "outDir": "./dist/types",
    "skipLibCheck": true
  },
  "include": ["src/types/**/*.ts"]
}
